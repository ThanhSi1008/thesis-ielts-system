{
  "expo": {
    "name": "IELTS Master AI",
    "slug": "ielts-master-ai",
    "icon": "./assets/images/splash.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "backgroundColor": "#3B82F6",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.ieltsmasterai.app",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.972613399189-253neiuhg06gf6ij83coff4bp81p2p0s"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.ieltsmasterai.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for dictation and shadowing.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to recognize your speech for shadowing exercises."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for speaking tests."
        }
      ],
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser",
      "expo-tracking-transparency",
      "./plugins/withRemovePushNotifications"
    ],
    "scheme": "iemai",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    }
  }
}
