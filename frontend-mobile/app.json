{
  "expo": {
    "name": "IELTS Master AI",
    "slug": "ielts-master-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#3B82F6",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ieltsmasterai.app"
    },
    "android": {
      "package": "com.ieltsmasterai.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for dictation and shadowing.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to recognize your speech for shadowing exercises."
        }
      ],
      "expo-audio",
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "scheme": "ielts-master-ai"
  }
}
