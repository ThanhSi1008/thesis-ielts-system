// Prisma Schema for TOEIC Master AI
// Database: PostgreSQL with pgvector extension

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model with role-based access control
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  role      UserRole @default(STUDENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  examSessions          ExamSession[]
  results               Result[]
  progress              LearningProgress[]
  pronunciationAttempts PronunciationAttempt[]
  vocabularyProgress    VocabularyProgress[]
  decks                 Deck[]
  questionNotes             QuestionNote[]
  shadowingVideos           ShadowingVideo[]
  shadowingFolders          ShadowingFolder[]
  shadowingDictationProgress ShadowingDictationProgress[]
  ieltsBasicProgress         IeltsBasicProgress[]
  ieltsWritingAnswers        IeltsWritingUserAnswer[]
  ieltsPracticeSessions      IeltsPracticeSession[]
  ieltsProfile               IeltsProfile?
  teacherLinks               StudentTeacherLink[] @relation("StudentLinks")
  studentLinks               StudentTeacherLink[] @relation("TeacherLinks")

  @@map("users")
}

enum UserRole {
  STUDENT
  ADMIN
  INSTRUCTOR
}

// Exam model - stores exam definitions
model Exam {
  id          String     @id @default(uuid())
  title       String
  description String?
  imageUrl    String?
  duration    Int // Duration in minutes
  type        ExamType
  difficulty  Difficulty
  isPublished Boolean    @default(false)
  questions   Json // Stores questions in JSON format
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  sessions ExamSession[]

  @@map("exams")
}

enum ExamType {
  FULL_TEST
  READING
  LISTENING
  SPEAKING
  WRITING
  PRACTICE
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// ExamSession model - tracks individual exam attempts
model ExamSession {
  id          String        @id @default(uuid())
  userId      String
  examId      String
  status      SessionStatus @default(IN_PROGRESS)
  answers     Json // Stores user answers
  timeTaken   Int?          // Exact time spent in seconds
  practicePart Int?
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam   Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  result Result?

  @@map("exam_sessions")
}

enum SessionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADING
  COMPLETED
  ABANDONED
}

// Result model - stores exam scores and feedback
model Result {
  id              String   @id @default(uuid())
  userId          String
  sessionId       String   @unique
  totalScore      Float
  readingScore    Int?
  listeningScore  Int?
  speakingScore   Float?
  writingScore    Float?
  feedback        Json? // AI-generated feedback
  gradedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("results")
}

// LearningMaterial model - stores learning content
model LearningMaterial {
  id          String   @id @default(uuid())
  title       String
  description String?
  content     Json // Stores content in structured format
  type        MaterialType
  difficulty  Difficulty
  tags        String[]
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  progress LearningProgress[]

  @@map("learning_materials")
}

enum MaterialType {
  LESSON
  VOCABULARY
  GRAMMAR
  PRACTICE
  VIDEO
  AUDIO
}

// LearningProgress model - tracks user progress
model LearningProgress {
  id         String   @id @default(uuid())
  userId     String
  materialId String
  progress   Int      @default(0) // Progress percentage (0-100)
  completed  Boolean  @default(false)
  lastAccess DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@map("learning_progress")
}

// Lesson model - represents a learning lesson/unit
model Lesson {
  id          String     @id @default(uuid())
  title       String
  description String?
  difficulty  Difficulty
  order       Int // For sequencing lessons
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  vocabularies Vocabulary[]
  grammars     Grammar[]

  @@map("lessons")
}

// Vocabulary model - individual vocabulary items within a lesson
model Vocabulary {
  id           String   @id @default(uuid())
  lessonId     String
  word         String
  meaning      String
  ipa          String? // IPA phonetic transcription (e.g., "/həˈloʊ/")
  audioUrl     String? // URL to pronunciation audio file in MinIO/GCS
  example      String?
  partOfSpeech String? // e.g., "noun", "verb", "adjective"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  lesson                Lesson                  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  pronunciationAttempts PronunciationAttempt[]

  @@map("vocabularies")
}

// Grammar model - grammar rules/explanations within a lesson
model Grammar {
  id        String   @id @default(uuid())
  lessonId  String
  title     String // Grammar topic title (e.g., "Present Perfect Tense")
  rule      String   @db.Text // Explanation of the grammar rule
  example   String // Example sentences demonstrating the rule
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("grammars")
}

// PronunciationAttempt model - tracks user pronunciation practice attempts
model PronunciationAttempt {
  id              String                   @id @default(uuid())
  userId          String
  vocabularyId    String?
  audioUrl        String // User's recording URL
  transcribedText String? // AI-transcribed text
  targetWord      String // Expected word
  score           Int? // 0-100
  feedback        Json? // Detailed feedback
  status          PronunciationStatus      @default(PENDING)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary? @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@map("pronunciation_attempts")
}

enum PronunciationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================================
// LEARNING CONTENT MODELS (Vocabulary, Grammar, Pronunciation)
// ============================================================

// Vocabulary Book (e.g., "4000 Essential English Words Book 1")
model VocabularyBook {
  id        String   @id @default(uuid())
  name      String
  imageUrl  String
  wordCount Int
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units VocabularyUnit[]

  @@map("vocabulary_books")
}

// Vocabulary Unit (e.g., "Unit 1: The Lion and the Rabbit")
model VocabularyUnit {
  id        String   @id @default(uuid())
  bookId    String
  title     String
  order     Int
  // Story content for reading comprehension
  storyTitle   String?
  storyContent String?  @db.Text
  storyImageUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book  VocabularyBook  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  words VocabularyWord[]
  exercises VocabularyExercise[]
  questions VocabularyQuestion[]
  progress  VocabularyProgress[]

  @@map("vocabulary_units")
}

// Vocabulary Word within a unit
model VocabularyWord {
  id           String   @id @default(uuid())
  unitId       String
  word         String
  meaning      String
  ipa          String?
  partOfSpeech String?
  example      String?
  imageUrl     String?
  audioUrl     String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  unit VocabularyUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("vocabulary_words")
}

// Vocabulary Exercise (definition matching quiz)
model VocabularyExercise {
  id       String @id @default(uuid())
  unitId   String
  question String // The definition
  answer   String // The correct word
  options  Json   // Array of word options
  order    Int    @default(0)

  unit VocabularyUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("vocabulary_exercises")
}

// Vocabulary Question (story comprehension)
model VocabularyQuestion {
  id       String @id @default(uuid())
  unitId   String
  question String
  type     String // "multiple_choice" or "fill_blank"
  options  Json?  // For multiple choice
  answer   String
  order    Int    @default(0)

  unit VocabularyUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("vocabulary_questions")
}

// Vocabulary Progress - tracks user learning progress per unit
model VocabularyProgress {
  id            String    @id @default(uuid())
  userId        String
  unitId        String
  wordsLearned  Int       @default(0)
  totalWords    Int       @default(20)
  exerciseScore Int?      // Score out of 100
  questionScore Int?      // Score out of 100
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit VocabularyUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@map("vocabulary_progress")
}

// Grammar Book (Cambridge Grammar in Use series)
model GrammarBook {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  author    String
  level     String   // "Elementary", "Intermediate", "Advanced"
  imageUrl  String
  color     String   // Hex color for UI
  unitCount Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units GrammarUnit[]

  @@map("grammar_books")
}

// Grammar Unit (e.g., "Unit 1: Present Continuous")
model GrammarUnit {
  id            String   @id @default(uuid())
  bookId        String
  title         String
  order         Int
  theoryContent String?  @db.Text // HTML or Markdown content
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  book      GrammarBook       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  exercises GrammarExercise[]

  @@map("grammar_units")
}

// Grammar Exercise
model GrammarExercise {
  id       String @id @default(uuid())
  unitId   String
  section  String // "1.1", "1.2", etc.
  question String @db.Text
  type     String // "fill_blank", "match", "multiple_choice", "rewrite"
  options  Json?
  answer   String @db.Text
  order    Int    @default(0)

  unit GrammarUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("grammar_exercises")
}

// Pronunciation Sound (IPA symbols)
model PronunciationSound {
  id          String   @id @default(uuid())
  symbol      String   @unique
  type        String   // "monophthong", "diphthong", "consonant"
  word        String   // Example word
  description String?  @db.Text
  imageUrl    String?  // Mouth position diagram
  audioUrl    String?
  voiced      Boolean? // For consonants
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pronunciation_sounds")
}

// ============================================================
// VOCAB LAB (Spaced Repetition Flashcards)
// ============================================================

enum CardState {
  NEW
  LEARNING
  REVIEW
}

model Deck {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]

  @@map("decks")
}

model Flashcard {
  id             String    @id @default(uuid())
  deckId         String
  front          String
  back           String    @db.Text
  tags           String[]
  interval       Int       @default(0)
  repetition     Int       @default(0)
  easeFactor     Float     @default(2.5)
  nextReviewDate DateTime  @default(now())
  cardState      CardState @default(NEW)
  cardTypeId     String?
  fieldValues    Json      @default("{}")
  fieldStyles    Json?
  cardStyle      Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deck     Deck              @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardType CardType?         @relation(fields: [cardTypeId], references: [id])
  reviews  FlashcardReview[]

  @@map("flashcards")
}

model FlashcardReview {
  id          String   @id @default(uuid())
  flashcardId String
  rating      Int      // 0-5 (SM-2 quality scale)
  reviewedAt  DateTime @default(now())

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@map("flashcard_reviews")
}

// Card Types (Anki-style field definitions)
model CardType {
  id          String   @id @default(uuid())
  userId      String?  // null = built-in system type
  name        String
  description String?  @db.Text // AI prompt context: what this card type is for
  isBuiltIn   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields     CardTypeField[]
  templates  CardTemplate[]
  flashcards Flashcard[]

  @@map("card_types")
}

model CardTypeField {
  id          String   @id @default(uuid())
  cardTypeId  String
  name        String
  order       Int
  description String?
  fieldType   String   @default("text") // 'text' | 'media'
  createdAt   DateTime @default(now())

  cardType CardType @relation(fields: [cardTypeId], references: [id], onDelete: Cascade)

  @@map("card_type_fields")
}

model CardTemplate {
  id          String   @id @default(uuid())
  cardTypeId  String
  name        String
  frontFields String[] // ordered field IDs shown on front
  backFields  String[] // ordered field IDs shown on back
  fieldStyles Json     @default("{}") // Record<fieldId, FieldStyle>
  cardStyle   Json     @default("{}") // CardStyle (bg, font family, etc.)
  createdAt   DateTime @default(now())

  cardType CardType @relation(fields: [cardTypeId], references: [id], onDelete: Cascade)

  @@map("card_templates")
}


// ============================================================
// QUESTION NOTES (per-user, per-exam, per-question)
// ============================================================

model QuestionNote {
  id             String   @id @default(uuid())
  userId         String
  examId         String
  questionNumber Int
  noteText       String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, examId, questionNumber])
  @@map("question_notes")
}

// ============================================================
// SHADOWING & DICTATION
// ============================================================

// User-uploaded videos for Shadowing/Dictation practice
model ShadowingVideo {
  id             String   @id @default(uuid())
  userId         String
  title          String
  youtubeVideoId String
  folder         String   @default("All Videos")
  category       String   @default("Other")
  duration       String
  sentences      Json     // Array of ShadowingSentence {id, english, vietnamese, phonetic, words, audioStart, audioEnd}
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shadowing_videos")
}

// User-created folders to organize their videos
model ShadowingFolder {
  id     String @id @default(uuid())
  userId String
  name   String
  order  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("shadowing_folders")
}

// Progress tracking for both Shadowing and Dictation per lesson
model ShadowingDictationProgress {
  id                  String   @id @default(uuid())
  userId              String
  lessonId            String   // Static lesson ID (e.g. "toeic-1") or ShadowingVideo.id
  type                String   // "shadowing" or "dictation"
  completedSentences  Int[]    // Indices of completed sentences
  dictationDifficulty String?  // "Beginner" | "Intermediate" | "Advanced" | "Expert" (dictation only)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, type])
  @@map("shadowing_dictation_progress")
}

// ============================================================
// IELTS BASIC LEARNING MODELS
// ============================================================

model IeltsSkill {
  id                 String                   @id @default(uuid())
  name               String                   @unique // "Listening", "Reading", "Writing", "Speaking"
  order              Int
  lessons            IeltsLesson[]
  listeningExercises IeltsListeningExercise[]
  readingExercises   IeltsReadingExercise[]
  writingExercises   IeltsWritingExercise[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@map("ielts_skills")
}

model IeltsLesson {
  id                 String                   @id @default(uuid())
  skillId            String
  chapter            String?                  // e.g., "Chapter 01"
  title              String                   // e.g., "Multiple Choice"
  content            Json                     // Structured array of content blocks
  quiz               Json?                    // Array of { question, options, answer, hint, explanation }
  order              Int
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  skill              IeltsSkill               @relation(fields: [skillId], references: [id], onDelete: Cascade)
  listeningExercises IeltsListeningExercise[]
  readingExercises   IeltsReadingExercise[]
  writingExercises   IeltsWritingExercise[]
  progress           IeltsBasicProgress[]

  @@map("ielts_lessons")
}

model IeltsListeningExercise {
  id           String      @id @default(uuid())
  skillId      String
  lessonId     String?
  topic        String      // e.g., "Melbourne City Tour Inquiry"
  instructions String?
  audioUrl     String      // Always required for listening
  transcript   Json        // Array of { speaker, text, question_number?, highlight_text? }
  content      Json        // Array of question groups (type: multiple_choice | table | map_labelling | ...)
  order        Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  skill        IeltsSkill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  lesson       IeltsLesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress     IeltsBasicProgress[]

  @@map("ielts_listening_exercises")
}

model IeltsReadingExercise {
  id                   String      @id @default(uuid())
  skillId              String
  lessonId             String?
  topic                String      // e.g., "The Automobile and the American Dream"
  instructions         String?
  passage              String      // Plain text passage
  passageWithLocations Json?       // Annotated array with inline question anchors
  content              Json        // Array of question groups (type: multiple_choice | matching_headings | ...)
  order                Int
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  skill        IeltsSkill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  lesson       IeltsLesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress     IeltsBasicProgress[]

  @@map("ielts_reading_exercises")
}

model IeltsBasicProgress {
  id                  String   @id @default(uuid())
  userId              String
  lessonId            String?
  listeningExerciseId String?
  readingExerciseId   String?
  writingExerciseId   String?
  isCompleted         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson            IeltsLesson?            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  listeningExercise IeltsListeningExercise? @relation(fields: [listeningExerciseId], references: [id], onDelete: Cascade)
  readingExercise   IeltsReadingExercise?   @relation(fields: [readingExerciseId], references: [id], onDelete: Cascade)
  writingExercise   IeltsWritingExercise?   @relation(fields: [writingExerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, listeningExerciseId, readingExerciseId, writingExerciseId], name: "user_item_unique")
  @@map("ielts_basic_progress")
}

model IeltsWritingExercise {
  id           String      @id @default(uuid())
  skillId      String
  lessonId     String?
  topic        String
  instructions String?
  prompt       String      @db.Text
  diagramUrl   String?
  modelAnswer  Json
  order        Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  skill        IeltsSkill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  lesson       IeltsLesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress     IeltsBasicProgress[]
  userAnswers  IeltsWritingUserAnswer[]

  @@map("ielts_writing_exercises")
}

model IeltsWritingUserAnswer {
  id                String   @id @default(uuid())
  userId            String
  writingExerciseId String
  intro             String   @db.Text
  overview          String   @db.Text
  body1             String   @db.Text
  body2             String   @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  writingExercise   IeltsWritingExercise @relation(fields: [writingExerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, writingExerciseId])
  @@map("ielts_writing_user_answers")
}

// ============================================================
// IELTS ADVANCED PRACTICE
// ============================================================

model IeltsPracticeListeningPart {
  id             String   @id @default(uuid())
  title          String   // e.g. "Cambridge 20 Test 4 - Listening Part 1"
  partNumber     Int      // 1, 2, 3, 4
  audioUrl       String
  transcript     Json     // Speaker and text segments
  content        Json     // Structure array using basic component types
  questionTypes  String[] // e.g., ["form_completion", "multiple_choice"]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions       IeltsPracticeSession[]

  @@map("ielts_practice_listening_parts")
}

model IeltsPracticeSession {
  id             String   @id @default(uuid())
  userId         String
  partId         String
  answers        Json     // User's submitted answers
  scoreData      Json     // Detailed struct tracking correct/total by question type
                           // e.g. {"form_completion": {"correct": 0, "total": 10}, "multiple_choice": ...}
  totalScore     Int
  totalQuestions Int
  createdAt      DateTime @default(now())

  part           IeltsPracticeListeningPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ielts_practice_sessions")
}

model IeltsProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique

  targetBand          Float?
  dailyCommitmentMins Int?     @default(30)
  placementScore      Int?
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ielts_profiles")
}

// ============================================================
// STUDENT-TEACHER LINKING
// ============================================================

model StudentTeacherLink {
  id        String   @id @default(uuid())
  studentId String
  teacherId String
  status    String   @default("LINKED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   User @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)
  teacher   User @relation("TeacherLinks", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, teacherId])
  @@map("student_teacher_links")
}

