// Prisma Schema for IELTS Master AI
// Database: PostgreSQL with pgvector extension

generator client {
  provider = "prisma-client-js"
}

// generator dbml {
//   provider   = "prisma-dbml-generator"
//   output     = "../../_thesis_paper/relational_diagram"
//   outputName = "schema.dbml"
// }

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model with role-based access control
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String? // Nullable: Google OAuth users have no password
  googleId  String?  @unique // Google sub — unique per Google account
  avatar    String? // Google profile picture URL
  firstName String?
  lastName  String?
  role      UserRole @default(STUDENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  examSessions             IeltsIntensiveSession[]
  results                  IeltsIntensiveResult[]
  pronunciationAttempts    FoundationPronunciationAttempt[]
  pronunciationProgress    FoundationPronunciationProgress[]
  vocabularyProgress       FoundationVocabProgress[]
  grammarProgress          FoundationGrammarProgress[]
  decks                    Deck[]
  sharedDecks              SharedDeck[]
  questionNotes            QuestionNote[]
  shadowingVideos          ShadowingVideo[]                  @relation("UserShadowingVideos")
  shadowingFolders         ShadowingFolder[]                 @relation("UserShadowingFolders")
  shadowingProgress        ShadowingProgress[]               @relation("UserShadowingProgress")
  dictationVideos          DictationVideo[]                  @relation("UserDictationVideos")
  dictationFolders         DictationFolder[]                 @relation("UserDictationFolders")
  dictationProgress        DictationProgress[]               @relation("UserDictationProgress")
  ieltsBasicProgress       IeltsBasicProgress[]
  ieltsWritingAnswers      IeltsBasicWritingAnswer[]
  practiceSessions         IeltsAdvancedListeningSession[]
  practiceReadingSessions  IeltsAdvancedReadingSession[]
  advancedWritingSessions  IeltsAdvancedWritingSession[]
  advancedSpeakingSessions IeltsAdvancedSpeakingSession[]

  userAchievements UserAchievement[]
  xpLogs           XpLog[]

  ieltsProfile  IeltsProfile?
  teacherLinks  StudentTeacherLink[] @relation("StudentLinks")
  studentLinks  StudentTeacherLink[] @relation("TeacherLinks")
  notifications Notification[]
  posts         Post[]               @relation("UserPosts")
  comments      Comment[]            @relation("UserComments")
  postLikes     PostLike[]           @relation("UserPostLikes")
  bookmarks     PostBookmark[]       @relation("UserBookmarks")
  subscription  Subscription?
  pushTokens    PushToken[]
  importJobs    ContentImportJob[]
  auditLogs     AdminAuditLog[]

  @@map("users")
}

enum UserRole {
  STUDENT
  ADMIN
  INSTRUCTOR
}

// Exam model - stores exam definitions
model IeltsIntensiveExam {
  id          String                 @id @default(uuid())
  title       String
  description String?
  imageUrl    String?
  duration    Int // Duration in minutes
  type        IeltsIntensiveExamType
  difficulty  Difficulty
  isPublished Boolean                @default(false)
  questions   Json // Stores questions in JSON format
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  // Provenance fields
  source      String?
  bookNumber  Int?
  testNumber  Int?
  quarter     String?
  year        Int?
  importJobId String?

  // Relations
  sessions IeltsIntensiveSession[]

  @@map("exams")
}

enum IeltsIntensiveExamType {
  FULL_TEST
  READING
  LISTENING
  SPEAKING
  WRITING
  PRACTICE

  @@map("ExamType")
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// ExamSession model - tracks individual exam attempts
model IeltsIntensiveSession {
  id           String                      @id @default(uuid())
  userId       String
  examId       String
  status       IeltsIntensiveSessionStatus @default(IN_PROGRESS)
  answers      Json // Stores user answers
  timeTaken    Int? // Exact time spent in seconds
  practicePart Int?
  startedAt    DateTime                    @default(now())
  submittedAt  DateTime?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  // Relations
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  ieltsIntensiveExam   IeltsIntensiveExam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  ieltsIntensiveResult IeltsIntensiveResult?

  @@map("exam_sessions")
}

enum IeltsIntensiveSessionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADING
  GRADED
  COMPLETED
  ABANDONED
  GRADING_FAILED

  @@map("SessionStatus")
}

// Result model - stores exam scores and feedback
model IeltsIntensiveResult {
  id             String   @id @default(uuid())
  userId         String
  sessionId      String   @unique
  totalScore     Float
  readingScore   Int?
  listeningScore Int?
  speakingScore  Float?
  writingScore   Float?
  feedback       Json? // AI-generated feedback
  gradedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  ieltsIntensiveSession IeltsIntensiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("results")
}

// ============================================================
// PRONUNCIATION ATTEMPT (used by AI grading flow)
// POST /pronunciation/check → creates attempt → AI worker updates result
model FoundationPronunciationAttempt {
  id              String              @id @default(uuid())
  userId          String
  vocabularyId    String?
  audioUrl        String // User's recording URL
  transcribedText String? // AI-transcribed text
  targetWord      String // Expected word
  score           Int? // 0-100
  feedback        Json? // Detailed feedback
  status          PronunciationStatus @default(PENDING)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pronunciation_attempts")
}

enum PronunciationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================================
// LEARNING CONTENT MODELS (FoundationVocabWord, Grammar, Pronunciation)
// ============================================================

// FoundationVocabWord Book (e.g., "4000 Essential English Words Book 1")
model FoundationVocabBook {
  id        String   @id @default(uuid())
  name      String
  imageUrl  String
  wordCount Int
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units FoundationVocabUnit[]

  @@map("vocabulary_books")
}

// FoundationVocabWord Unit (e.g., "Unit 1: The Lion and the Rabbit")
model FoundationVocabUnit {
  id            String   @id @default(uuid())
  bookId        String
  title         String
  order         Int
  // Story content for reading comprehension
  storyTitle    String?
  storyContent  String?  @db.Text
  storyImageUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  book      FoundationVocabBook       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  words     FoundationVocabItem[]
  questions FoundationVocabQuestion[]
  progress  FoundationVocabProgress[]

  @@map("vocabulary_units")
}

// FoundationVocabWord Word within a unit
model FoundationVocabItem {
  id           String   @id @default(uuid())
  unitId       String
  word         String
  meaning      String
  ipa          String?
  partOfSpeech String?
  example      String?
  imageUrl     String?
  audioUrl     String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  unit FoundationVocabUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("vocabulary_words")
}

// FoundationVocabWord Question (story comprehension)
model FoundationVocabQuestion {
  id       String @id @default(uuid())
  unitId   String
  question String
  type     String // "multiple_choice" or "fill_blank"
  options  Json? // For multiple choice
  answer   String
  order    Int    @default(0)

  unit FoundationVocabUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("vocabulary_questions")
}

// FoundationVocabWord Progress - tracks user learning progress per unit
model FoundationVocabProgress {
  id            String    @id @default(uuid())
  userId        String
  unitId        String
  wordsLearned  Int       @default(0)
  totalWords    Int       @default(20)
  questionScore Int? // Score out of 100
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit FoundationVocabUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@map("vocabulary_progress")
}

// Grammar Book (Cambridge Grammar in Use series)
model FoundationGrammarBook {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  author    String
  level     String // "Elementary", "Intermediate", "Advanced"
  imageUrl  String
  color     String // Hex color for UI
  unitCount Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units FoundationGrammarUnit[]

  @@map("grammar_books")
}

// Grammar Unit (e.g., "Unit 1: Present Continuous")
model FoundationGrammarUnit {
  id            String   @id @default(uuid())
  bookId        String
  title         String
  order         Int
  theoryContent String?  @db.Text // HTML or Markdown content
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  book      FoundationGrammarBook       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  exercises FoundationGrammarExercise[]
  progress  FoundationGrammarProgress[]

  @@map("grammar_units")
}

// Grammar Exercise
model FoundationGrammarExercise {
  id       String @id @default(uuid())
  unitId   String
  section  String // "1.1", "1.2", etc.
  question String @db.Text
  type     String // "fill_blank", "match", "multiple_choice", "rewrite"
  options  Json?
  answer   String @db.Text
  order    Int    @default(0)

  unit FoundationGrammarUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("grammar_exercises")
}

// Grammar Progress (per-user, per-unit)
model FoundationGrammarProgress {
  id              String    @id @default(uuid())
  userId          String
  unitId          String
  theoryCompleted Boolean   @default(false)
  exerciseScore   Int? // Best score (correct count)
  exerciseTotal   Int? // Total exercise count
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit FoundationGrammarUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@map("grammar_progress")
}

// Pronunciation Sound (IPA symbols)
model FoundationPronunciationSound {
  id          String   @id @default(uuid())
  symbol      String   @unique
  type        String // "monophthong", "diphthong", "consonant"
  word        String // Primary example word (shown on chart tile)
  name        String? // Human-readable name, e.g. "Long E", "Voiceless Dental Fricative"
  description String?  @db.Text // How to produce the sound (paragraph)
  tip         String?  @db.Text // Short pronunciation tip (displayed in a callout)
  imageUrl    String? // Mouth position diagram URL
  audioUrl    String? // Audio of the isolated sound
  videoUrl    String? // Optional video demonstration URL
  voiced      Boolean? // For consonants
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  exampleWords FoundationSoundExample[]
  progress     FoundationPronunciationProgress[]

  @@map("pronunciation_sounds")
}

model FoundationSoundExample {
  id       String  @id @default(uuid())
  soundId  String
  word     String // e.g. "sheep"
  ipa      String? // e.g. "/ʃiːp/"
  audioUrl String? // Audio URL for this specific word
  order    Int     @default(0)

  sound FoundationPronunciationSound @relation(fields: [soundId], references: [id], onDelete: Cascade)

  @@map("sound_example_words")
}

model FoundationPronunciationProgress {
  id              String               @id @default(uuid())
  userId          String
  soundId         String
  status          PronunciationMastery @default(NEW)
  practiceCount   Int                  @default(0) // Total practice attempts on this sound
  bestScore       Int? // Best score achieved (0-100)
  lastPracticedAt DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sound FoundationPronunciationSound @relation(fields: [soundId], references: [id], onDelete: Cascade)

  @@unique([userId, soundId])
  @@map("pronunciation_progress")
}

enum PronunciationMastery {
  NEW // Never practiced
  PRACTICING // Practiced but best score < 80
  MASTERED // Best score >= 80
}

// ============================================================
// VOCAB LAB (Spaced Repetition Flashcards)
// ============================================================

enum CardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

// ============================================================
// SUBSCRIPTION & PRICING
// ============================================================

enum SubscriptionTier {
  FREE
  PREMIUM
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentProvider {
  MOCK // Thesis demo — simulated payments
  VNPAY // VNPay payment gateway
  STRIPE // Future — real payment processing
  MANUAL // Admin-granted subscriptions
}

model Deck {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]

  @@map("decks")
}

model Flashcard {
  id             String    @id @default(uuid())
  deckId         String
  front          String
  back           String    @db.Text
  tags           String[]
  audioUrl       String?    @db.Text // TTS-generated pronunciation audio (e.g. AI-created cards); null = no audio
  // FSRS scheduling fields
  due            DateTime  @default(now())
  stability      Float     @default(0)
  difficulty     Float     @default(0)
  elapsedDays    Int       @default(0)
  scheduledDays  Int       @default(0)
  reps           Int       @default(0)
  lapses         Int       @default(0)
  lastReview     DateTime?
  nextReviewDate DateTime  @default(now()) // Keeping for backward compatibility temporarily
  cardState      CardState @default(NEW)
  cardTypeId     String?
  fieldValues    Json      @default("{}")
  fieldStyles    Json?
  cardStyle      Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deck     Deck              @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardType CardType?         @relation(fields: [cardTypeId], references: [id])
  reviews  FlashcardReview[]

  @@map("flashcards")
}

model FlashcardReview {
  id            String     @id @default(uuid())
  flashcardId   String
  rating        Int // 1=Again, 2=Hard, 3=Good, 4=Easy (FSRS scale)
  reviewedAt    DateTime   @default(now())
  // FSRS review log fields
  scheduledDays Int        @default(0)
  elapsedDays   Int        @default(0)
  state         CardState?

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@map("flashcard_reviews")
}

// Card Types (Anki-style field definitions)
model CardType {
  id          String   @id @default(uuid())
  userId      String? // null = built-in system type
  name        String
  description String?  @db.Text // AI prompt context: what this card type is for
  isBuiltIn   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields     CardTypeField[]
  templates  CardTemplate[]
  flashcards Flashcard[]

  @@map("card_types")
}

model CardTypeField {
  id          String   @id @default(uuid())
  cardTypeId  String
  name        String
  order       Int
  description String?
  fieldType   String   @default("text") // 'text' | 'media'
  createdAt   DateTime @default(now())

  cardType CardType @relation(fields: [cardTypeId], references: [id], onDelete: Cascade)

  @@map("card_type_fields")
}

model CardTemplate {
  id          String   @id @default(uuid())
  cardTypeId  String
  name        String
  frontFields String[] // ordered field IDs shown on front
  backFields  String[] // ordered field IDs shown on back
  fieldStyles Json     @default("{}") // Record<fieldId, FieldStyle>
  cardStyle   Json     @default("{}") // CardStyle (bg, font family, etc.)
  createdAt   DateTime @default(now())

  cardType CardType @relation(fields: [cardTypeId], references: [id], onDelete: Cascade)

  @@map("card_templates")
}

// ============================================================
// VOCAB LAB SHARED (COMMUNITY)
// ============================================================

model SharedDeck {
  id           String   @id @default(uuid())
  publisherId  String
  name         String
  description  String?  @db.Text
  tags         String[]
  lexonPayload Json
  importCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  publisher User @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@index([publisherId])
  @@index([importCount])
  @@map("shared_decks")
}

// ============================================================
// QUESTION NOTES (per-user, per-exam, per-question)
// ============================================================

model QuestionNote {
  id             String   @id @default(uuid())
  userId         String
  examId         String
  questionNumber Int
  noteText       String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, examId, questionNumber])
  @@map("question_notes")
}

// ============================================================
// SHADOWING
// ============================================================

// Shadowing videos (system-provided and user-uploaded)
// sentences JSON: {id, english, vietnamese, phonetic, words[], audioStart, audioEnd}
model ShadowingVideo {
  id             String   @id @default(uuid())
  userId         String? // null = system lesson
  title          String
  youtubeVideoId String?
  audioUrl       String?
  imageUrl       String?
  tags           String[] @default([])
  folder         String   @default("All Videos")
  category       String   @default("Other")
  duration       String
  sentences      Json
  status         String   @default("READY")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User? @relation("UserShadowingVideos", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("shadowing_videos")
}

// User-created folders for shadowing videos
model ShadowingFolder {
  id     String @id @default(uuid())
  userId String
  name   String
  order  Int    @default(0)

  user User @relation("UserShadowingFolders", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("shadowing_folders")
}

// Progress tracking for Shadowing — no difficulty, no type discriminator
model ShadowingProgress {
  id                 String   @id @default(uuid())
  userId             String
  lessonId           String
  completedSentences Int[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation("UserShadowingProgress", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("shadowing_progress")
}

// ============================================================
// DICTATION
// ============================================================

// Dictation videos (system-provided and user-uploaded)
// sentences JSON: {id, english, words[], audioStart, audioEnd}  (no vietnamese/phonetic)
model DictationVideo {
  id             String   @id @default(uuid())
  userId         String? // null = system lesson
  title          String
  youtubeVideoId String?
  audioUrl       String?
  imageUrl       String?
  tags           String[] @default([])
  folder         String   @default("All Videos")
  category       String   @default("Other")
  duration       String
  sentences      Json
  status         String   @default("READY")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User? @relation("UserDictationVideos", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("dictation_videos")
}

// User-created folders for dictation videos
model DictationFolder {
  id     String @id @default(uuid())
  userId String
  name   String
  order  Int    @default(0)

  user User @relation("UserDictationFolders", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("dictation_folders")
}

// Progress tracking for Dictation — includes difficulty level
model DictationProgress {
  id                 String   @id @default(uuid())
  userId             String
  lessonId           String
  completedSentences Int[]
  difficulty         String   @default("Intermediate") // Beginner | Intermediate | Advanced | Expert
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation("UserDictationProgress", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("dictation_progress")
}

// ============================================================
// IELTS BASIC LEARNING MODELS
// ============================================================

model IeltsBasicSkill {
  id                 String                        @id @default(uuid())
  name               String                        @unique // "Listening", "Reading", "Writing", "Speaking"
  order              Int
  lessons            IeltsBasicLesson[]
  listeningExercises IeltsBasicListeningExercise[]
  readingExercises   IeltsBasicReadingExercise[]
  writingExercises   IeltsBasicWritingExercise[]
  speakingExercises  IeltsBasicSpeakingExercise[]
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@map("ielts_skills")
}

model IeltsBasicLesson {
  id        String   @id @default(uuid())
  skillId   String
  chapter   String? // e.g., "Chapter 01"
  title     String // e.g., "Multiple Choice"
  content   Json // Structured array of content blocks
  quiz      Json? // Array of { question, options, answer, hint, explanation }
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skill              IeltsBasicSkill               @relation(fields: [skillId], references: [id], onDelete: Cascade)
  listeningExercises IeltsBasicListeningExercise[]
  readingExercises   IeltsBasicReadingExercise[]
  writingExercises   IeltsBasicWritingExercise[]
  speakingExercises  IeltsBasicSpeakingExercise[]
  progress           IeltsBasicProgress[]

  @@map("ielts_lessons")
}

model IeltsBasicListeningExercise {
  id           String   @id @default(uuid())
  skillId      String
  lessonId     String?
  topic        String // e.g., "Melbourne City Tour Inquiry"
  instructions String?
  audioUrl     String // Always required for listening
  transcript   Json // Array of { speaker, text, question_number?, highlight_text? }
  content      Json // Array of question groups (type: multiple_choice | table | map_labelling | ...)
  order        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  skill    IeltsBasicSkill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  lesson   IeltsBasicLesson?    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress IeltsBasicProgress[]

  @@map("ielts_listening_exercises")
}

model IeltsBasicReadingExercise {
  id                   String   @id @default(uuid())
  skillId              String
  lessonId             String?
  topic                String // e.g., "The Automobile and the American Dream"
  instructions         String?
  passage              String // Plain text passage
  passageWithLocations Json? // Annotated array with inline question anchors
  content              Json // Array of question groups (type: multiple_choice | matching_headings | ...)
  order                Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  skill    IeltsBasicSkill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  lesson   IeltsBasicLesson?    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress IeltsBasicProgress[]

  @@map("ielts_reading_exercises")
}

model IeltsBasicProgress {
  id                  String   @id @default(uuid())
  userId              String
  lessonId            String?
  listeningExerciseId String?
  readingExerciseId   String?
  writingExerciseId   String?
  speakingExerciseId  String?
  isCompleted         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson            IeltsBasicLesson?            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  listeningExercise IeltsBasicListeningExercise? @relation(fields: [listeningExerciseId], references: [id], onDelete: Cascade)
  readingExercise   IeltsBasicReadingExercise?   @relation(fields: [readingExerciseId], references: [id], onDelete: Cascade)
  writingExercise   IeltsBasicWritingExercise?   @relation(fields: [writingExerciseId], references: [id], onDelete: Cascade)
  speakingExercise  IeltsBasicSpeakingExercise?  @relation(fields: [speakingExerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, listeningExerciseId, readingExerciseId, writingExerciseId, speakingExerciseId], name: "user_item_unique")
  @@map("ielts_basic_progress")
}

model IeltsBasicWritingExercise {
  id           String   @id @default(uuid())
  skillId      String
  lessonId     String?
  topic        String
  instructions String?
  prompt       String   @db.Text
  diagramUrl   String?
  modelAnswer  Json
  order        Int
  taskType     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  skill       IeltsBasicSkill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  lesson      IeltsBasicLesson?         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress    IeltsBasicProgress[]
  userAnswers IeltsBasicWritingAnswer[]

  @@map("ielts_writing_exercises")
}

model IeltsBasicWritingAnswer {
  id                String   @id @default(uuid())
  userId            String
  writingExerciseId String
  answers           Json     @default("{}") // Map of blankId → selectedAnswer
  score             Int? // Number of correct blanks
  totalBlanks       Int? // Total number of blanks
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  writingExercise IeltsBasicWritingExercise @relation(fields: [writingExerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, writingExerciseId])
  @@map("ielts_writing_user_answers")
}

model IeltsBasicSpeakingExercise {
  id           String   @id @default(uuid())
  skillId      String
  lessonId     String?
  topic        String
  partType     Int
  questionType String   @default("cloze")
  instructions String?
  prompt       String   @db.Text
  content      Json?
  modelAnswer  Json?
  order        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  skill    IeltsBasicSkill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  lesson   IeltsBasicLesson?    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress IeltsBasicProgress[]

  @@map("ielts_speaking_exercises")
}

// ============================================================
// IELTS ADVANCED PRACTICE
// ============================================================

model IeltsAdvancedListeningPart {
  id            String   @id @default(uuid())
  title         String // e.g. "Cambridge 20 Test 4 - Listening Part 1"
  partNumber    Int // 1, 2, 3, 4
  audioUrl      String
  transcript    Json // Speaker and text segments
  content       Json // Structure array using basic component types
  questionTypes String[] // e.g., ["form_completion", "multiple_choice"]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Provenance fields
  source      String?
  bookNumber  Int?
  testNumber  Int?
  isPublished Boolean @default(true)
  importJobId String?

  sessions IeltsAdvancedListeningSession[]

  @@map("ielts_practice_listening_parts")
}

model IeltsAdvancedListeningSession {
  id             String   @id @default(uuid())
  userId         String
  partId         String
  answers        Json // User's submitted answers
  scoreData      Json // Detailed struct tracking correct/total by question type
  // e.g. {"form_completion": {"correct": 0, "total": 10}, "multiple_choice": ...}
  totalScore     Int
  totalQuestions Int
  createdAt      DateTime @default(now())

  part IeltsAdvancedListeningPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  user User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ielts_practice_sessions")
}

model IeltsAdvancedReadingPart {
  id                   String   @id @default(uuid())
  title                String // e.g. "Cambridge 17 Test 1 - Reading Part 1"
  partNumber           Int // 1, 2, 3
  passage              String   @db.Text
  passageWithLocations Json?
  content              Json // Structure array using basic component types
  questionTypes        String[] // e.g., ["multiple_choice", "matching_headings"]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Provenance fields
  source      String?
  bookNumber  Int?
  testNumber  Int?
  isPublished Boolean @default(true)
  importJobId String?

  sessions IeltsAdvancedReadingSession[]

  @@map("ielts_practice_reading_parts")
}

model IeltsAdvancedReadingSession {
  id             String   @id @default(uuid())
  userId         String
  partId         String
  answers        Json
  scoreData      Json
  totalScore     Int
  totalQuestions Int
  createdAt      DateTime @default(now())

  part IeltsAdvancedReadingPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  user User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ielts_practice_reading_sessions")
}

// ── IELTS ADVANCED WRITING ──

model IeltsAdvancedWritingPrompt {
  id            String   @id @default(uuid())
  taskType      String // "TASK_1" or "TASK_2"
  subType       String // e.g. "line_graph", "bar_chart", "opinion", "discussion"
  source        String   @default("engnovate") // "cambridge_13", "forecast", etc.
  category      String   @default("cambridge-academic") // category slug
  bookNumber    Int?
  testNumber    Int?
  title         String
  prompt        String   @db.Text
  imageUrl      String?
  minimumWords  Int      @default(150)
  suggestedTime Int      @default(20) // minutes
  difficulty    String   @default("medium")
  engnovateSlug String?  @unique
  isPublished   Boolean  @default(true)
  importJobId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions IeltsAdvancedWritingSession[]

  @@map("ielts_advanced_writing_prompts")
}

model IeltsAdvancedWritingSession {
  id         String   @id @default(uuid())
  userId     String
  promptId   String
  essay      String?  @db.Text
  draftEssay String?  @db.Text // auto-saved draft
  timeTaken  Int? // seconds spent writing
  status     String   @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | GRADING | GRADED | GRADING_FAILED
  feedback   Json? // AI grading result (same shape as existing WritingFeedback)
  bandScore  Float? // overall band score
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt IeltsAdvancedWritingPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([promptId])
  @@map("ielts_advanced_writing_sessions")
}

// ── IELTS ADVANCED SPEAKING ──

model IeltsAdvancedSpeakingPart {
  id            String   @id @default(uuid())
  partNumber    Int // 1, 2, or 3
  partType      String // "interview" | "cue_card" | "discussion"
  topic         String // e.g. "Personal Qualities", "News & Media"
  source        String   @default("engnovate") // "cambridge_20", "forecast", etc.
  category      String   @default("cambridge-academic") // category slug
  bookNumber    Int?
  testNumber    Int?
  title         String
  questions     Json // Array of { text: string }
  engnovateSlug String?
  isPublished   Boolean  @default(true)
  importJobId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions IeltsAdvancedSpeakingSession[]

  @@unique([engnovateSlug, partNumber])
  @@map("ielts_advanced_speaking_parts")
}

model IeltsAdvancedSpeakingSession {
  id            String   @id @default(uuid())
  userId        String
  partId        String
  audioUrls     Json? // Array of base64 audio strings (one per question)
  transcription Json? // AI-generated transcription per question
  timeTaken     Int? // total seconds spent
  status        String   @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | GRADING | GRADED | GRADING_FAILED
  feedback      Json? // AI grading result
  bandScore     Float? // overall band score
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  part IeltsAdvancedSpeakingPart @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([partId])
  @@map("ielts_advanced_speaking_sessions")
}

model IeltsProfile {
  id     String @id @default(uuid())
  userId String @unique

  targetBand          Float?
  dailyCommitmentMins Int?      @default(30)
  examDate            DateTime?
  placementScore      Int?
  placementListening  Int?
  placementReading    Int?
  placementWriting    Int?
  onboardingCompleted Boolean   @default(false)

  // ── Streak Tracking ──
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime? // Date of last activity (no time data, or start of day)

  totalXp Int @default(0)
  level   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ielts_profiles")
}

// ============================================================
// STUDENT-TEACHER LINKING
// ============================================================

model StudentTeacherLink {
  id        String   @id @default(uuid())
  studentId String
  teacherId String
  status    String   @default("LINKED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)
  teacher User @relation("TeacherLinks", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, teacherId])
  @@map("student_teacher_links")
