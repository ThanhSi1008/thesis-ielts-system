# Database Configuration
DATABASE_URL="postgresql://toeic_user:toeic_password@localhost:5433/toeic_db?schema=public"

# Redis Configuration
REDIS_URL="redis://localhost:6379"
REDIS_TTL=3600

# RabbitMQ Configuration
RABBITMQ_URL="amqp://toeic:toeic_password@localhost:5672"
RABBITMQ_QUEUE_GRADING="exam-grading-queue"
RABBITMQ_EXCHANGE="toeic-exchange"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRATION="30d"

# Object Storage Configuration (MinIO for local, GCS for production)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="toeic-files"
STORAGE_REGION="us-east-1"
STORAGE_USE_SSL="false"

# Application Configuration
PORT=3000
NODE_ENV="development"
API_PREFIX="api/v1"

# CORS Configuration
CORS_ORIGIN="http://localhost:3001,http://localhost:19006"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL="debug"

