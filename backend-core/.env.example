# ─── Database (Supabase / Local Docker) ──────────────────────────────────────
# Pooler port 6543 — dùng cho Prisma ORM (query engine)
DATABASE_URL="postgresql://ielts_user:ielts_password@localhost:5433/ielts_db?schema=public"
# Direct port 5432 — dùng cho Prisma migrations
DIRECT_URL="postgresql://ielts_user:ielts_password@localhost:5433/ielts_db"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL="amqp://ielts:ielts_password@localhost:5672"
RABBITMQ_QUEUE_GRADING="exam-grading-queue"
RABBITMQ_QUEUE_TRANSCRIPTION="dictation-transcription-queue"
RABBITMQ_EXCHANGE="ielts-exchange"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRATION="30d"

# ─── Cloudinary (image/audio upload) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com

# ─── Application ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV="development"
API_PREFIX="api/v1"

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:3001,http://localhost:19006"

# ─── Payment Provider ────────────────────────────────────────────────────────
# "mock" tự động approve (local/CI). "vnpay" dùng VNPay Sandbox/Production.
PAYMENT_PROVIDER=mock

# ─── VNPay Config (chỉ cần khi PAYMENT_PROVIDER=vnpay) ───────────────────────
VNPAY_TMN_CODE=YOUR_TMN_CODE
VNPAY_HASH_SECRET=YOUR_HASH_SECRET
# Sandbox: https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Production: https://pay.vnpay.vn/vpcpay.html
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Browser redirect URL sau khi thanh toán. Thay bằng domain thật khi production.
# Local: http://localhost:3001/payment/vnpay-return
# Production: https://ielts-master.io.vn/payment/vnpay-return
VNPAY_RETURN_URL=http://localhost:3001/payment/vnpay-return
# IPN URL cấu hình trong VNPay merchant portal (không gửi qua API params).
# Local: cần ngrok. Production: https://dedangdown.io.vn/api/v1/subscriptions/webhook/vnpay
VNPAY_IPN_URL=http://localhost:3000/api/v1/subscriptions/webhook/vnpay

# ─── Exchange Rate ────────────────────────────────────────────────────────────
# Tỷ giá USD → VND fallback cho VNPay checkout. Cron tự động cập nhật từ API.
# Giá trị này chỉ dùng khi cả Redis cache lẫn API đều không khả dụng.
USD_TO_VND_RATE=25400

# ─── OpenTelemetry (optional, chỉ production) ────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
