  userId String [not null]
  createdAt DateTime [default: `now()`, not null]
  post posts [not null]
  user users [not null]

  indexes {
    (postId, userId) [unique]
  }
}

Table subscriptions {
  id String [pk]
  userId String [unique, not null]
  tier SubscriptionTier [not null, default: 'FREE']
  status SubscriptionStatus [not null, default: 'ACTIVE']
  provider PaymentProvider
  providerSubId String
  currentPeriodStart DateTime
  currentPeriodEnd DateTime
  canceledAt DateTime
  trialEndsAt DateTime
  trialUsed Boolean [not null, default: false]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  user users [not null]
  payments payments [not null]
  usageRecords usage_records [not null]
}

Table payments {
  id String [pk]
  subscriptionId String [not null]
  amount Int [not null]
  currency String [not null, default: 'USD']
  provider PaymentProvider [not null]
  providerPayId String
  status String [not null]
  metadata Json
  createdAt DateTime [default: `now()`, not null]
  subscription subscriptions [not null]
}

Table usage_records {
  id String [pk]
  subscriptionId String [not null]
  feature String [not null]
  count Int [not null, default: 0]
  periodStart DateTime [not null]
  periodEnd DateTime [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  subscription subscriptions [not null]

  indexes {
    (subscriptionId, feature, periodStart) [unique]
  }
}

Table pricing_plans {
  id String [pk]
  tier SubscriptionTier [not null]
  name String [not null]
  description String
  priceAmount Int [not null]
  currency String [not null, default: 'USD']
  interval String [not null]
  intervalCount Int [not null, default: 1]
  features Json [not null]
  isActive Boolean [not null, default: true]
  order Int [not null, default: 0]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Enum UserRole {
  STUDENT
  ADMIN
  INSTRUCTOR
}

Enum IeltsIntensiveExamType {
  FULL_TEST
  READING
  LISTENING
  SPEAKING
  WRITING
  PRACTICE
}

Enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

Enum IeltsIntensiveSessionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADING
  GRADED
  COMPLETED
  ABANDONED
  GRADING_FAILED
}



Enum PronunciationMastery {
  NEW
  PRACTICING
  MASTERED
}

Enum CardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

Enum SubscriptionTier {
  FREE
  PREMIUM
  PRO
}

Enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

Enum PaymentProvider {
  MOCK
  VNPAY
  STRIPE
  MANUAL
}

Enum NotificationType {
  STREAK_MILESTONE
  LESSON_COMPLETED
  REVIEW_DUE
  DECK_MASTERED
  EXAM_GRADED
  NEW_EXAM_AVAILABLE
  DICTATION_COMPLETE
  NEW_LESSON
  SYSTEM_ANNOUNCEMENT
  ACHIEVEMENT
}

Enum PostType {
  STUDY_TIP
  SCORE_ACHIEVEMENT
  GENERAL
}

