enum UserRole {
  + STUDENT
  + ADMIN
  + INSTRUCTOR
}

enum IeltsIntensiveExamType {
  + FULL_TEST
  + READING
  + LISTENING
  + SPEAKING
  + WRITING
  + PRACTICE
}

enum Difficulty {
  + BEGINNER
  + INTERMEDIATE
  + ADVANCED
}

enum IeltsIntensiveSessionStatus {
  + IN_PROGRESS
  + SUBMITTED
  + GRADING
  + GRADED
  + COMPLETED
  + ABANDONED
  + GRADING_FAILED
}

enum PronunciationMastery {
  + NEW
  + PRACTICING
  + MASTERED
}

class User {
  - id: String
  - email: String
  - password: String?
  - googleId: String?
  - avatar: String?
  - firstName: String?
  - lastName: String?
  - isActive: Boolean
  - createdAt: DateTime
  - updatedAt: DateTime
}

class IeltsIntensiveExam {
  - id: String
  - title: String
  - description: String?
  - imageUrl: String?
  - duration: Int
  - isPublished: Boolean
  - questions: Json
  - createdAt: DateTime
  - updatedAt: DateTime
}

class IeltsIntensiveSession {
  - id: String
  - userId: String
  - examId: String
  - answers: Json
  - timeTaken: Int?
  - practicePart: Int?
