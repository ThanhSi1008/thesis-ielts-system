@startuml
skinparam linetype ortho
skinparam classAttributeIconSize 0
hide methods

enum UserRole {
  + STUDENT
  + ADMIN
  + INSTRUCTOR
}

enum IeltsIntensiveExamType {
  + FULL_TEST
  + READING
  + LISTENING
  + SPEAKING
  + WRITING
  + PRACTICE
}

enum Difficulty {
  + BEGINNER
  + INTERMEDIATE
  + ADVANCED
}

enum IeltsIntensiveSessionStatus {
  + IN_PROGRESS
  + SUBMITTED
  + GRADING
  + GRADED
  + COMPLETED
  + ABANDONED
  + GRADING_FAILED
}

enum PronunciationMastery {
  + NEW
  + PRACTICING
  + MASTERED
}

class User {
  - id: String
  - email: String
  - password: String [0..1]
  - googleId: String [0..1]
  - avatar: String [0..1]
  - firstName: String [0..1]
  - lastName: String [0..1]
  - isActive: Boolean
  - createdAt: DateTime
  - updatedAt: DateTime
}

class IeltsIntensiveExam {
  - id: String
  - title: String
  - description: String [0..1]
  - imageUrl: String [0..1]
  - duration: Int
  - isPublished: Boolean
  - questions: Json
  - createdAt: DateTime
  - updatedAt: DateTime
}

class IeltsIntensiveSession {
  - id: String
  - userId: String
  - examId: String
  - answers: Json
  - timeTaken: Int [0..1]
  - practicePart: Int [0..1]
  - startedAt: DateTime
  - submittedAt: DateTime [0..1]
  - createdAt: DateTime
  - updatedAt: DateTime
}

class IeltsIntensiveResult {
  - id: String
  - userId: String
  - sessionId: String
  - totalScore: Float
  - readingScore: Int [0..1]
  - listeningScore: Int [0..1]
  - speakingScore: Float [0..1]
  - writingScore: Float [0..1]
  - feedback: Json [0..1]
  - gradedAt: DateTime
  - createdAt: DateTime
  - updatedAt: DateTime
}

