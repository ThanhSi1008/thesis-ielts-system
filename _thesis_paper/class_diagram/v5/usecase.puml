@startuml
left to right direction
skinparam usecase {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}
skinparam linetype polyline

' Thêm padding để biểu đồ rộng ra
skinparam nodesep 40
skinparam ranksep 80

actor "User" as User
actor "Admin" as Admin

rectangle "Hệ thống TOEIC Master" {

  ' --- CORE HUBS ---
  usecase "Đăng ký" as Register
  usecase "Quản lý tài khoản" as Account
  usecase "Học tập IELTS" as Study
  usecase "Luyện tập mở rộng" as Practice
  
  usecase "Từ vựng (Vocab Lab)" as Vocab
  usecase "Cộng đồng" as Community
  usecase "Quản trị hệ thống" as AdminHub

  usecase "Đăng nhập" as Login

  ' --- LAYOUT HINTS TO SPREAD HORIZONTALLY ---
  ' Đẩy Vocab, Community, AdminHub sang cột bên phải
  Account -[hidden]right-> Vocab
  Study -[hidden]right-> Community
  Practice -[hidden]right-> AdminHub

  ' Đẩy Đăng nhập sang phía cuối cùng bên phải
  Vocab -[hidden]right-> Login
  Community -[hidden]right-> Login

  ' --- SUB-USE CASES (ACCOUNT) ---
  usecase "Quản lý hồ sơ" as UC_Profile
  usecase "Nâng cấp gói cước" as UC_Sub
  usecase "Xem bảng xếp hạng" as UC_Rank
  usecase "Xem lộ trình" as UC_Roadmap
  usecase "Xem thông báo" as UC_Notif

  UC_Profile .up.> Account : <<Extend>>
  UC_Sub .up.> Account : <<Extend>>
  UC_Rank .down.> Account : <<Extend>>
  UC_Roadmap .down.> Account : <<Extend>>
  UC_Notif .down.> Account : <<Extend>>

  ' --- SUB-USE CASES (STUDY) ---
  usecase "Học nền tảng" as UC_Found
  usecase "Luyện Basic" as UC_Basic
  usecase "Luyện Advanced" as UC_Adv
  usecase "Làm bài thi thử" as UC_Mock
  usecase "Xem kết quả" as UC_Result
  usecase "Tính điểm IELTS" as UC_Calc
  usecase "Hỏi đáp AI" as UC_AI

  UC_Found .up.> Study : <<Extend>>
  UC_Basic .up.> Study : <<Extend>>
  UC_Adv .up.> Study : <<Extend>>
  UC_Mock .down.> Study : <<Extend>>
  UC_Result .down.> Study : <<Extend>>
  UC_Calc .down.> Study : <<Extend>>
  UC_AI .down.> Study : <<Extend>>

  ' --- SUB-USE CASES (VOCAB LAB) ---
  usecase "Tạo/Sửa bộ thẻ" as UC_Deck
  usecase "Quản lý Flashcard" as UC_Card
  usecase "Ôn tập Spaced Repetition" as UC_Review
  usecase "Khám phá/Tải thẻ" as UC_Share
  usecase "Xem thống kê" as UC_VocabStat

  UC_Deck .up.> Vocab : <<Extend>>
  UC_Card .up.> Vocab : <<Extend>>
  UC_Review .down.> Vocab : <<Extend>>
  UC_Share .down.> Vocab : <<Extend>>
  UC_VocabStat .down.> Vocab : <<Extend>>

  ' --- SUB-USE CASES (PRACTICE) ---
  usecase "Luyện Shadowing" as UC_Shadow
  usecase "Luyện Dictation" as UC_Dict
  usecase "Thêm Video học" as UC_Video

  UC_Shadow .up.> Practice : <<Extend>>
  UC_Dict .down.> Practice : <<Extend>>
  UC_Video .down.> Practice : <<Extend>>

  ' --- SUB-USE CASES (COMMUNITY) ---
  usecase "Tạo bài đăng" as UC_Post
  usecase "Bình luận" as UC_Comment
  usecase "Lưu bài viết" as UC_Bookmark
  usecase "Thả tim" as UC_Like

  UC_Post .up.> Community : <<Extend>>
  UC_Comment .up.> Community : <<Extend>>
  UC_Bookmark .down.> Community : <<Extend>>
  UC_Like .down.> Community : <<Extend>>

  ' --- SUB-USE CASES (ADMIN) ---
  usecase "Quản lý người dùng" as UC_AdUser
  usecase "Quản lý nội dung" as UC_AdContent
  usecase "Quản lý doanh thu" as UC_AdRev

  UC_AdUser .up.> AdminHub : <<Extend>>
  UC_AdContent .down.> AdminHub : <<Extend>>
  UC_AdRev .down.> AdminHub : <<Extend>>

  ' --- INCLUDES ---
  Account ..> Login : <<Include>>
  Study ..> Login : <<Include>>
  Vocab ..> Login : <<Include>>
  Practice ..> Login : <<Include>>
  Community ..> Login : <<Include>>
  AdminHub ..> Login : <<Include>>
}

' --- ACTOR CONNECTIONS ---
User --> Register
User --> Account
User --> Study
User --> Practice
User --> Vocab
User --> Community

Admin --> AdminHub

@enduml
