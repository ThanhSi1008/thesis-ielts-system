# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=production
PORT=8000
LOG_LEVEL=INFO

# ── Database (Supabase direct — port 5432) ─────────────
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── RabbitMQ (CloudAMQP) ──────────────────────────────────────────────────────
RABBITMQ_URL=amqps://<user>:<password>@<host>.lmq.cloudamqp.com/<vhost>

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy<key>

# ── Google Cloud Storage ──────────────────────────────────────────────────────
GCS_BUCKET_NAME=<project-id>_cloudbuild

# ── Whisper model ─────────────────────────────────────────────────────────────
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── Worker ────────────────────────────────────────────────────────────────────
MAX_WORKERS=2
CONSUMER_PREFETCH_COUNT=1

# ── Internal service URL ──────────────────────────────────────────────────────
BACKEND_CORE_URL=http://backend-core:3000/api/v1
