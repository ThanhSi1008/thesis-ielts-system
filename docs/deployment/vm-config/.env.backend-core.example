# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
API_PREFIX=api/v1
PORT=3000
LOG_LEVEL=info

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Pooler port 6543 — dùng cho Prisma ORM (query engine)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct port 5432 — dùng cho Prisma migrations
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
REDIS_TTL=3600

# ── RabbitMQ (CloudAMQP) ──────────────────────────────────────────────────────
RABBITMQ_URL=amqps://<user>:<password>@<host>.lmq.cloudamqp.com/<vhost>
RABBITMQ_QUEUE_GRADING=exam-grading-queue
RABBITMQ_EXCHANGE=toeic-exchange

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=<random-hex-64-chars>
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=<random-hex-64-chars>
JWT_REFRESH_EXPIRATION=30d

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-<secret>

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated nếu nhiều domain
CORS_ORIGIN=https://your-frontend-domain.com
