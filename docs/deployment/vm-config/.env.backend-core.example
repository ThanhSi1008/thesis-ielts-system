# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
API_PREFIX=api/v1
PORT=3000

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Pooler port 6543 — dùng cho Prisma ORM (query engine)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct port 5432 — dùng cho Prisma migrations
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# ── RabbitMQ (CloudAMQP) ──────────────────────────────────────────────────────
RABBITMQ_URL=amqps://<user>:<password>@<host>.lmq.cloudamqp.com/<vhost>
RABBITMQ_QUEUE_GRADING=exam-grading-queue
RABBITMQ_QUEUE_TRANSCRIPTION=dictation-transcription-queue
RABBITMQ_EXCHANGE=toeic-exchange

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=<random-hex-64-chars>
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=<random-hex-64-chars>
JWT_REFRESH_EXPIRATION=30d

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=<ios-client-id>.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=<android-client-id>.apps.googleusercontent.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated nếu nhiều domain
CORS_ORIGIN=https://ielts-master.io.vn

# ── Payment ───────────────────────────────────────────────────────────────────
# "mock" tự động approve. "vnpay" dùng cổng thanh toán VNPay.
PAYMENT_PROVIDER=vnpay

# Credentials từ cổng VNPay production (https://vnpay.vn/merchant)
# Sandbox dùng: https://sandbox.vnpayment.vn/merchant_webapi/merchant.html
VNPAY_TMN_CODE=<tmn_code>
VNPAY_HASH_SECRET=<hash_secret>

# Sandbox:    https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Production: https://pay.vnpay.vn/vpcpay.html
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# URL trình duyệt user redirect về sau khi thanh toán (phía frontend)
VNPAY_RETURN_URL=https://ielts-master.io.vn/payment/vnpay-return

# IPN URL cấu hình trong VNPay merchant portal (server-to-server callback)
# Endpoint hiện có: GET /api/v1/subscriptions/webhook/vnpay
VNPAY_IPN_URL=https://dedangdown.io.vn/api/v1/subscriptions/webhook/vnpay

# ── Exchange Rate ─────────────────────────────────────────────────────────────
# Tỷ giá USD → VND fallback. Cron tự cập nhật từ API, giá trị này chỉ dùng khi
# cả Redis cache lẫn API đều không khả dụng.
USD_TO_VND_RATE=25400
