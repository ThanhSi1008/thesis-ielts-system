# ── Frontend Web — Cloud Run deployment ───────────────────────────────────────
# Build-time vars (NEXT_PUBLIC_*) phải được set lúc `npm run build`.
# Cloud Run: set trong Cloud Build substitutions hoặc Dockerfile ARG → ENV.

# ── API ───────────────────────────────────────────────────────────────────────
# Backend Core API (qua nginx reverse proxy trên VM)
NEXT_PUBLIC_API_URL=https://dedangdown.io.vn/api/v1
# WebSocket URL cho real-time notifications
NEXT_PUBLIC_WS_URL=wss://dedangdown.io.vn

# ── Google OAuth ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="IELTS Master AI"
NEXT_PUBLIC_APP_VERSION="1.0.0"
