# RabbitMQ Configuration
RABBITMQ_URL="amqp://toeic:toeic_password@localhost:5672"
RABBITMQ_QUEUE_GRADING="exam-grading-queue"
RABBITMQ_EXCHANGE="toeic-exchange"

# Database Configuration (for updating exam results)
DATABASE_URL="postgresql://toeic_user:toeic_password@localhost:5432/toeic_db"

# Object Storage Configuration (MinIO for local, GCS for production)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="toeic-files"
STORAGE_REGION="us-east-1"
STORAGE_USE_SSL="false"

# Google Cloud Storage (for production)
GCS_BUCKET_NAME="toeic-files"
GCS_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# AI Model Configuration
WHISPER_MODEL="base"  # Options: tiny, base, small, medium, large
WHISPER_DEVICE="cpu"  # Options: cpu, cuda
WHISPER_COMPUTE_TYPE="int8"  # Options: int8, float16, float32
LLM_MODEL_PATH="./models/llm"
LLM_DEVICE="cpu"

# Groq API Key (free tier — model: llama-3.3-70b-versatile)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=""

# Backend Core URL (for writing result callback)
BACKEND_CORE_URL="http://localhost:3000/api/v1"

# Application Configuration
PORT=8000
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Worker Configuration
MAX_WORKERS=2
CONSUMER_PREFETCH_COUNT=1

