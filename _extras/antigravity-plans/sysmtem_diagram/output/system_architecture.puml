@startuml system_architecture
' Final assembly — vertical stack layout (thesis-friendly width)

allowmixing
skinparam shadowing false
skinparam linetype polyline
skinparam defaultFontName "Arial"
skinparam dpi 200
skinparam nodesep 22
skinparam ranksep 38
skinparam padding 4
skinparam wrapWidth 280
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #616161
skinparam legendFontSize 10

title TOEIC Master AI — System Architecture Diagram

caption Generated from codebase analysis. All connections are code-verified.

top to bottom direction

' --- Presentation (blue) ---
skinparam rectangle<<FrontendWeb>> {
  BackgroundColor #2196F3
  FontColor #FFFFFF
  BorderColor #0D47A1
  BorderThickness 2
}
skinparam rectangle<<FrontendMobile>> {
  BackgroundColor #42A5F5
  FontColor #FFFFFF
  BorderColor #01579B
  BorderThickness 2
}

' --- Application (green) ---
skinparam rectangle<<BackendCore>> {
  BackgroundColor #4CAF50
  FontColor #FFFFFF
  BorderColor #1B5E20
  BorderThickness 2
}
skinparam rectangle<<BackendAI>> {
  BackgroundColor #66BB6A
  FontColor #FFFFFF
  BorderColor #1B5E20
  BorderThickness 2
}
skinparam rectangle<<AppGroup>> {
  BackgroundColor #C8E6C9
  FontColor #000000
  BorderColor #2E7D32
}
skinparam card<<BCMod>> {
  BackgroundColor #FFFFFF
  BorderColor #2E7D32
  FontColor #000000
}
skinparam card<<BAIRest>> {
  BackgroundColor #E8F5E9
  BorderColor #1B5E20
  FontColor #000000
}
skinparam card<<BAIAsync>> {
  BackgroundColor #F1F8E9
  BorderColor #33691E
  FontColor #000000
}
skinparam card<<BAISvc>> {
  BackgroundColor #DCEDC8
  BorderColor #558B2F
  FontColor #000000
}

' --- Data layer (orange) ---
skinparam database {
  BackgroundColor #FFECB3
  BorderColor #E65100
  FontColor #000000
}
skinparam queue {
  BackgroundColor #FFECB3
  BorderColor #E65100
  FontColor #000000
}
skinparam card<<DataCard>> {
  BackgroundColor #FFF8E1
  BorderColor #BF360C
  FontColor #000000
}
skinparam rectangle<<DevOnly>> {
  BorderStyle dashed
  BorderThickness 2
  BackgroundColor #FFECB3
  BorderColor #E65100
  FontColor #000000
}

' --- External (purple) ---
skinparam cloud<<External>> {
  BackgroundColor #E1BEE7
  BorderColor #6A1B9A
  BorderThickness 2
  FontColor #000000
}

rectangle "TOEIC system (top → bottom)" as PLATFORM #FAFAFA {

  rectangle "1 · Presentation layer" as PRES_LAYER #E3F2FD {
    rectangle "Frontend Web\nNext.js + Tailwind · :3001\nAxios · localStorage · → Core :3000/api/v1\n→ AI chat :8000/api/v1/chat" <<FrontendWeb>> as FW
    rectangle "Frontend Mobile\nExpo + Expo Router · **no port**\nfetch · AsyncStorage · → Core only\n//no direct AI//" <<FrontendMobile>> as FM
  }

  rectangle "2 · Application layer" as APP_LAYER #E8F5E9 {
    rectangle "Backend Core · NestJS · :3000 /api/v1\n//REST orchestrator//" <<BackendCore>> as BC {
      together {
        card "Core · Auth, Users" <<BCMod>> as BC_CORE
        card "IELTS · Exams, IeltsModule" <<BCMod>> as BC_IELTS2
        card "Learning · Vocab, Grammar,\nShadowing, Dictation, VocabLab" <<BCMod>> as BC_LEARN2
        card "Engage · Gamification,\nNotifications, Posts, Notes" <<BCMod>> as BC_ENG2
        card "Business · Subscriptions,\nLearningModule (VNPay)" <<BCMod>> as BC_BIZ
      }
      together {
        card "Infra · Prisma, Redis,\nCache, Cloudinary storage" <<BCMod>> as BC_INFRA2
        card "**AiClientModule** · AMQP publish" <<BCMod>> as BC_AI2
      }
    }

    rectangle "Backend AI · FastAPI · :8000\n//REST + queue consumers//" <<BackendAI>> as BAI {
      rectangle "REST (sync)" <<AppGroup>> as BAI_REST {
        card "/chat · /writing/grade\n/speaking/grade · /grading/* · /health" <<BAIRest>> as BAI_EP
      }
      rectangle "Consumers (async)" <<AppGroup>> as BAI_CONS {
        card "GradingConsumer · exam-grading-queue" <<BAIAsync>> as BAI_GC
        card "PronunciationConsumer · pronunciation-check-queue" <<BAIAsync>> as BAI_PC
        card "TranscriptionConsumer · dictation-transcription-queue" <<BAIAsync>> as BAI_TC
      }
      card "Whisper (CPU) · Graders · Pronunciation\nStorage · boto3 + HTTP" <<BAISvc>> as BAI_SHARED
    }
  }

  rectangle "3 · Data layer" as DATA_LAYER #FFF3E0 {
    together {
      database "PostgreSQL 16 · toeic_db\n:5433→5432 · toeic-postgres\nPrisma (Core) + psycopg2 (AI)" as PG
      database "Redis 7 · :6379 · toeic-redis\nAOF · **Core only**" as RD
      queue "RabbitMQ 3 · :5672 / :15672\ntoeic-rabbitmq" as RMQ {
        card "exam-grading-queue" <<DataCard>> as Q_GRADING
        card "pronunciation-check-queue" <<DataCard>> as Q_PRON
        card "dictation-transcription-queue" <<DataCard>> as Q_DICT
      }
      rectangle "MinIO (dev) · :9000 / :9001\ntoeic-minio · S3 · **dashed = non-prod**" <<DevOnly>> as MINIO
    }
  }

  rectangle "4 · External services\n//backends only — no FE links//" as EXT_LAYER #F3E5F5 {
    cloud "Google Gemini\ngemini-2.5-flash · google-genai\n//AI service only//" <<External>> as GEMINI
    cloud "Cloudinary · media CDN\nNode SDK · Core uploads" <<External>> as CLOUDINARY
    cloud "Google OAuth · AuthModule" <<External>> as GAUTH
    cloud "VNPay · payments · IPN webhook" <<External>> as VNPAY
    cloud "YouTube · yt-dlp · TranscriptionConsumer" <<External>> as YOUTUBE
  }
}

' === Data flows (compact labels) ===
FW -down-> BC : HTTP REST + JWT (Axios)
FM -down-> BC : HTTP REST + JWT (fetch)
FW -down-> BAI : HTTP REST · /api/v1/chat

BC -down-> RMQ : AMQP publish

RMQ -[#6A1B9A,dashed]up-> BAI_GC : AMQP consume
RMQ -[#6A1B9A,dashed]up-> BAI_PC : AMQP consume
RMQ -[#6A1B9A,dashed]up-> BAI_TC : AMQP consume

BC <--> PG : Prisma ORM
BAI -down-> PG : psycopg2 SQL
BAI_TC -up-> BC : HTTP PATCH webhook

BC <--> RD : ioredis

BC <--> CLOUDINARY : HTTPS SDK
BC <--> VNPAY : HTTPS · bidirectional
BC --> GAUTH : HTTPS · token check

BAI --> GEMINI : HTTPS · google-genai

BAI_PC --> MINIO : S3 · boto3
BAI_TC --> YOUTUBE : HTTPS · yt-dlp

legend bottom
  |= Color |= Meaning |
  | <#2196F3> | Presentation |
  | <#4CAF50> | Application |
  | <#FF9800> | Data |
  | <#9C27B0> | External |
  |= Line |= Meaning |
  | Solid | Sync HTTP / SQL / SDK |
  | Dashed | AMQP consume |
  | Double | Bidirectional |
  | Dashed box | MinIO dev-only |
end legend

@enduml
